{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildEnvironment": "V3"
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "deploy": {
      "startCommand": "export PYTHONPATH=$PYTHONPATH:. && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
      "sleepApplication": false,
      "useLegacyStacker": false,
      "ipv6EgressEnabled": false,
      "multiRegionConfig": {
        "sfo": {
          "numReplicas": 1
        }
      },
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10
    }
  }
}
